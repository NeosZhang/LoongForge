ARG BASE_IMAGE="iregistry.baidu-int.com/xmlir/xmlir_ubuntu_2004_x86_64:v0.33"
FROM ${BASE_IMAGE}

# =========================================================
# Build Arguments
# =========================================================
# LeRobot has dependency conflicts with the base environment; disabled by default.
# Enable only when training VLA models (e.g., Pi0.5, GR00T).
ARG ENABLE_LEROBOT="false"
ARG XPYTORCH_URL_ARG=""

WORKDIR /workspace

# =========================================================
# Base System Configuration + APT Source Replacement
# =========================================================
COPY ./LoongForge /workspace/LoongForge
COPY ./Loong-Megatron /workspace/Loong-Megatron
SHELL ["/bin/bash", "-c"]

# ======================== Basic Environment Setup ========================
RUN set -exuo pipefail && \
    clean_pip_config() { \
        rm -rf /opt/conda/pip.conf /root/.config/pip/pip.conf /root/.pip/pip.conf \
            /etc/pip.conf /etc/xdg/pip/pip.conf /usr/pip.conf; \
    }; \
    install_pip_config() { \
        mkdir -p /tmp && chmod -R 777 /tmp && \
        if [ -f /workspace/LoongForge/docker/pip.conf ]; then \
            cp /workspace/LoongForge/docker/pip.conf /etc/pip.conf && \
            cp /workspace/LoongForge/docker/pip.conf /usr/pip.conf && \
            mkdir -p /root/.pip && cp /workspace/LoongForge/docker/pip.conf /root/.pip/pip.conf && \
            mkdir -p /etc/xdg/pip && cp /workspace/LoongForge/docker/pip.conf /etc/xdg/pip/pip.conf; \
        fi; \
    }; \
    remove_pip_constraints() { \
        source_file="/etc/pip/constraint.txt" && \
        if [ -f "${source_file}" ]; then \
            backup_file="${source_file%.*}_backup.${source_file##*.}" && \
            mv -v "${source_file}" "${backup_file}" && \
            > "${source_file}"; \
        fi; \
    }; \
    setup_system_env() { \
        if [ -f /workspace/LoongForge/docker/sources.list ]; then \
            rm -rf /etc/apt/sources.list && \
            cp /workspace/LoongForge/docker/sources.list /etc/apt/sources.list; \
        fi && \
        rm -f /etc/apt/sources.list.d/ubuntu.sources && \
        apt-get update && \
        DEBIAN_FRONTEND=noninteractive apt-get install -y tzdata && \
        ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
        apt-get install -y bc tree pwgen nodejs iproute2; \
    }; \
    clean_pip_config && \
    install_pip_config && \
    remove_pip_constraints && \
    setup_system_env

# ======================== Install XPU Requirements ========================
RUN set -exuo pipefail && \
    download_xpytorch() { \
        local XPYTORCH_URL=$1; \
        local XPYTORCH_FILE=$(basename "${XPYTORCH_URL}"); \
        echo "download xpytorch package: ${XPYTORCH_URL}" && \
        wget "${XPYTORCH_URL}" && \
        bash "${XPYTORCH_FILE}" && \
        rm "${XPYTORCH_FILE}"; \
    }; \
    . /root/miniconda/etc/profile.d/conda.sh && \
    conda activate python310_torch25_cuda && \
    if [ -n "${XPYTORCH_URL_ARG}" ]; then \
        XPYTORCH_URL="${XPYTORCH_URL_ARG}"; \
        echo "use specified xpytorch version: ${XPYTORCH_URL}"; \
    else \
        xpytorch_info="/workspace/LoongForge/docker/xpytorch_info.txt"; \
        if [ ! -f "${xpytorch_info}" ]; then \
            echo "xpytorch info file not exist: ${xpytorch_info}" && exit 1; \
        fi; \
        DEFAULT_XPYTORCH_URL=$(cat "${xpytorch_info}" | tr -d '[:space:]'); \
        if [ -z "${DEFAULT_XPYTORCH_URL}" ]; then \
            echo "Error: xpytorch_info.txt file content is empty" && exit 1; \
        fi; \
        XPYTORCH_URL="${DEFAULT_XPYTORCH_URL}"; \
        echo "use default xpytorch version: ${XPYTORCH_URL}"; \
    fi && \
    download_xpytorch "${XPYTORCH_URL}"

# ======================== Install Base Requirements ========================
RUN set -exuo pipefail && \
    install_requirements() { \
        . /root/miniconda/etc/profile.d/conda.sh && \
        conda activate python310_torch25_cuda && \
        # for deepspeed cpu adam
        DS_BUILD_CPU_ADAM=1  BUILD_UTILS=1  pip install deepspeed==0.18.5 -U -i http://pip.baidu.com/pypi/simple --trusted-host pip.baidu.com && \
        echo "alias ll='ls -alF'" > /etc/profile.d/alias.sh; \
        echo "source /etc/profile.d/alias.sh" >> ~/.bashrc && \
        cd /workspace/LoongForge/ && \
        pip install uv && \
        uv pip install --no-config --no-cache -e ".[xpu]" \
            -i http://mirrors.baidubce.com/pypi/simple --allow-insecure-host mirrors.baidubce.com; \
    }; \
    install_requirements

# =========================================================
# Megatron / Lerobot
# =========================================================
RUN set -exuo pipefail && \
    install_megatron() { \
        local megatron_dir=/workspace/Loong-Megatron; \
        local MEGATRON_TAGS="core_v0.15.0" && \
        echo "Installing Loong-Megatron ${MEGATRON_TAGS}..." && \
        cd ${megatron_dir} && \
        echo "Loong-Megatron setup completed"; \
    }; \
    install_lerobot() { \
        echo "Installing lerobot..." && \
        cd /workspace && \
        if [ -d "lerobot" ]; then \
            rm -rf lerobot; \
        fi && \
        wget http://ai-data.bj.bcebos.com/lerobotv0.5.0.tar.gz && \
        tar -zxf lerobotv0.5.0.tar.gz && \
        cd lerobot && \
        if [ -f "requirements-ubuntu.txt" ]; then \
            sed -i '/evdev/d' requirements-ubuntu.txt; \
        fi && \
        pip install func_timeout pytest-xdist prettytable==3.11.0 huggingface-hub==0.34.0 && \
        sed -i -e '/"torch[>=<]/d' \
           -e 's/"torchvision[^"]*",/"torchvision==0.20.1",/' \
           -e '/python-can/d' \
           -e '/lerobot\[can-dep\]/d' \
           -e '/lerobot\[damiao\]/d' \
           -e '/unitree_g1 = \[/,/]/ { /matplotlib/d; /pin/d; /meshcat/d; /casadi/d; }' \
           -e '/lerobot-setup-can/d' \
           -e '/\[tool.setuptools.package-data\]/d' \
           -e '/lerobot = \["envs\/\*\.json"\]/d' \
           -e '/"OT_VALUE"/d' \
           -e 's/requires-python = ">=3\.12"/requires-python = ">=3.10"/g' \
           -e '/huggingface-hub>=1\.0\.0,<2\.0\.0/d' \
           pyproject.toml && \
        pip install "http://aihc-ai-datasets-bj.bj.bcebos.com/hac-aiacc/omni_training/ngc2506_torch28_cuda129_tev29/transformers-5.3.0-py3-none-any.whl" && \
        pip install --no-build-isolation -e .[peft-dep,scipy-dep] && \
        sed -i 's|tokenizer_name="google/paligemma-3b-pt-224",|tokenizer_name=config.tokenizer_name,|g' ./src/lerobot/policies/pi05/processor_pi05.py && \
        echo "Lerobot installation completed"; \
    }; \
    . /root/miniconda/etc/profile.d/conda.sh && \
    conda activate python310_torch25_cuda && \
    install_megatron && \
    if [ "$ENABLE_LEROBOT" = "true" ]; then \
        install_lerobot; \
    else \
        echo "Skipping lerobot installation (ENABLE_LEROBOT=${ENABLE_LEROBOT})"; \
    fi

# =========================================================
# Jupyter Configuration
# =========================================================
RUN mkdir -p /root/.jupyter && \
    touch /root/.jupyter/enterpoint.sh && \
    chmod +x /root/.jupyter/enterpoint.sh

# =========================================================
# Clean Up Unused Files (Consistent with install.sh)
# =========================================================
RUN rm -rf /tmp/* ~/.bash_history && \
    rm -rf /workspace/LoongForge/.git && \
    rm -rf /workspace/LoongForge/build.sh && \
    rm -rf /workspace/LoongForge/ci.yml && \
    rm -rf /workspace/LoongForge/docker/ci && \
    rm -rf /workspace/Loong-Megatron/.git && \
    rm -rf /workspace/Loong-Megatron/.github && \
    rm -rf /workspace/Loong-Megatron/output && \
    rm -rf /workspace/*.tar.gz && \
    rm -f /workspace/README.md /workspace/license.txt && \
    rm -rf /workspace/docker-examples /workspace/tutorials

WORKDIR /workspace